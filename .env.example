# =============================================================
# Твой Донер — переменные окружения
# Скопируйте этот файл в .env.local (локально) или добавьте
# переменные в Vercel → Project → Settings → Environment Variables.
# НИКОГДА не коммитьте реальные значения в git.
# =============================================================

# Адрес сайта (для SEO, sitemap, Open Graph). Без слеша в конце.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (Data API / API Keys)
# URL проекта, например https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Публичный ключ: "anon public" (legacy) или "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# СЕКРЕТНЫЙ ключ: "service_role" (legacy) или "secret" (sb_secret_...).
# Используется только на сервере. Без префикса NEXT_PUBLIC_ — иначе он утечёт в браузер.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram-бот для уведомлений о заказах (см. README → «Telegram»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Любая длинная случайная строка — «соль» для хэширования IP в антиспаме.
# Сгенерировать: openssl rand -hex 32
RATE_LIMIT_SALT=
